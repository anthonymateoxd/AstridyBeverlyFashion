[Unit]
Description=Backup de producción Astrid & Beverly Fashion
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/astrid/backup.env
ExecStart=/opt/astrid-quality-control/scripts/backup-production.sh --reason scheduled
TimeoutStartSec=2h
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
UMask=0077

[Install]
WantedBy=multi-user.target
