[Unit]
Description=ASTRID remove local inspection photos older than 7 days only after verified S3 copy
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/bin/bash /opt/astrid-release-d733420/archive_local_prune_safe.sh
TimeoutStartSec=35min
Nice=15
IOSchedulingClass=idle
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal
