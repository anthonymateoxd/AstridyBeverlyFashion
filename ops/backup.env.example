# Configuración de backup de producción.
# Este archivo no contiene credenciales AWS: el EC2 usa su IAM Role.

APP_DIR=/opt/astrid-quality-control
DEPLOY_USER=ubuntu

BACKUP_ROOT=/opt/astrid-backups
BACKUP_S3_BUCKET=REEMPLAZAR_CON_BUCKET_PRIVADO
BACKUP_S3_PREFIX=astrid/production
AWS_REGION=us-east-2

# 10 dumps MySQL locales + 30 manifests locales.
BACKUP_LOCAL_DB_KEEP=10
BACKUP_LOCAL_MANIFEST_KEEP=30

# Pausa brevemente el worker IA para capturar artefactos consistentes.
BACKUP_PAUSE_AI_WORKER=1

# Dejar vacío para SSE-S3 (AES256).
# Si luego se usa una CMK de KMS, colocar aquí su ARN o ID.
BACKUP_KMS_KEY_ID=

# Copia cifrada y versionada del .env en SSM Parameter Store.
BACKUP_CONFIG_TO_SSM=1
BACKUP_CONFIG_TO_S3=1
BACKUP_SSM_ENV_PARAMETER=/astrid/production/env-file

BACKUP_HEALTH_URL=http://127.0.0.1:5000/health
MAINTENANCE_LOCK=/var/lock/astrid-quality-maintenance.lock
