# ============================================================
# Astrid Quality Control - configuración de entorno
# Copie este archivo como .env y complete únicamente en privado.
# Nunca suba .env al repositorio.
# ============================================================

# Aplicación y usuario administrador inicial
SECRET_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
FLASK_DEBUG=0
APP_PORT=5000

# MySQL
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=textile_user
MYSQL_PASSWORD=
MYSQL_DATABASE=textile_quality_db
MYSQL_ROOT_PASSWORD=

# Cámara RTSP
CAMERA_INDEX=0
CAMERA_IP=192.168.0.8
CAMERA_USER=admin
CAMERA_PASSWORD=
CAMERA_RTSP_PORT=554
CAMERA_CHANNEL=1
CAMERA_SUBTYPE=0
CAMERA_WIDTH=2688
CAMERA_HEIGHT=1520
CAMERA_FPS=15
CAMERA_RETRY_SECONDS=3
CAMERA_FAILURE_LIMIT=3
CAMERA_OPEN_TIMEOUT_MS=4000
CAMERA_READ_TIMEOUT_MS=4000
CAMERA_READ_FAIL_RELEASE_LIMIT=3
CAMERA_LATENCY_LOG_INTERVAL_S=2.0
CAMERA_DISCOVERY_ENABLED=1
CAMERA_DISCOVERY_CIDR=
CAMERA_DISCOVERY_TIMEOUT=0.30
CAMERA_DISCOVERY_WORKERS=40

# Región de interés
ROI_X1=0.16
ROI_Y1=0.05
ROI_X2=0.84
ROI_Y2=0.88

# Inferencia PatchCore
# La producción resuelve el modelo ACTIVO asociado al lote.
PATCHCORE_CKPT=
PATCHCORE_IMAGE_SIZE=384
PATCHCORE_SCORE_THRESHOLD=55.20
PATCHCORE_PIXEL_THRESHOLD=0.72
PATCHCORE_MAX_BOX_RATIO=

# Detección auxiliar YOLO
YOLO_INFERENCE_CONF=0.40
YOLO_DEFECT_THRESHOLD=0.70

# Estación automática
AUTO_COOLDOWN_SECONDS=4
AUTO_MOTION_THRESHOLD=18000
AUTO_STABILIZATION_SECONDS=0.6
AUTO_GARMENT_ENTER_COVERAGE=0.28
AUTO_GARMENT_CAPTURE_COVERAGE=0.33
AUTO_GARMENT_EXIT_COVERAGE=0.12
AUTO_GARMENT_CONFIRM_FRAMES=3
AUTO_GARMENT_EXIT_FRAMES=3
AUTO_GARMENT_MAX_TRACK_FRAMES=16
FRAME_SELECTION_BENCHMARK=false

# Artefactos y captura IA
AI_ARTIFACTS_ROOT=/app/ai_artifacts
AI_CAPTURE_MIN_COVERAGE=0.48
AI_CAPTURE_MIN_SHARPNESS=40.0
AI_CAPTURE_TARGET_IMAGES=40
AI_CAPTURE_DUPLICATE_THRESHOLD=6
AI_CAPTURE_KEEP_REJECTED=false
AI_CAPTURE_JPEG_QUALITY=92

# Estación guiada
AI_GUIDED_PRESENT_COVERAGE=0.28
AI_GUIDED_EXIT_COVERAGE=0.12
AI_GUIDED_MAX_COVERAGE=0.98
AI_GUIDED_CENTER_TOL_X=0.12
AI_GUIDED_CENTER_TOL_Y=0.14
AI_GUIDED_EDGE_MARGIN=0.05
AI_GUIDED_STABILITY_FRAMES=4
AI_GUIDED_ENTER_FRAMES=3
AI_GUIDED_EXIT_FRAMES=3
AI_GUIDED_MANUAL_COOLDOWN_SECONDS=0.6

# Worker de entrenamiento IA
AI_WORKER_ID=worker-1
AI_WORKER_LOG_LEVEL=INFO
AI_WORKER_ONCE=0
AI_WORKER_POLL_SECONDS=3
AI_WORKER_ORPHAN_SECONDS=900
AI_WORKER_HEARTBEAT_SECONDS=15
PATCHCORE_INPUT_SIZE=256
PATCHCORE_BACKBONE=wide_resnet50_2
PATCHCORE_CORESET_RATIO=0.05
PATCHCORE_NUM_NEIGHBORS=9
PATCHCORE_SEED=42
PATCHCORE_BATCH_SIZE=4
