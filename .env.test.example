# Configuracion de la base de pruebas aislada y desechable.
#
# Copie este archivo como `.env.test` (queda fuera de git) y ajuste los
# valores. Las pruebas de este proyecto se niegan a ejecutarse si la base no
# se reconoce como desechable, y nunca cargan el `.env` de produccion.
#
# Con el contenedor local de pruebas:
#   docker run -d --name astrid-ai-validation-mysql \
#     -p 127.0.0.1:43316:3306 \
#     -e MYSQL_ROOT_PASSWORD=<clave aleatoria> \
#     -e MYSQL_DATABASE=astrid_ai_validation mysql:8.0
#
# Con un contenedor de pruebas en la misma red de Docker:
#   MYSQL_HOST=astrid-ai-validation-mysql
#   MYSQL_PORT=3306

MYSQL_HOST=127.0.0.1
MYSQL_PORT=43316
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=astrid_ai_validation
